# Copy to .env for local dev (npm run dev / npm run preview).
#
# PRODUCTION (Docker): .env is NOT shipped in the image. Set these same
# variables in the host platform's environment settings, then redeploy.
# Verify with:  https://your-domain/api/health   (ok:true = key accepted by Desk)

# Getnos Desk (server-side only, never exposed to the browser)
# Required for form submissions to work.
DESK_URL=https://deskbackend.getnos.io/v1/lead
DESK_API_KEY=your_desk_project_api_key

PORT=4173
